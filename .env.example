EXPO_PUBLIC_KAKAO_APP_KEY=dc20c43cdf2f8ffdc24ad4c184a1b6cb

# 백엔드 API 주소입니다. 실기기 테스트/외부 테스트 때는 배포 서버 주소를 넣으세요.
EXPO_PUBLIC_API_BASE_URL=http://52.87.76.168:8080

# 카카오톡 공유 메시지에서 사용할 공개 HTTPS 링크/이미지 주소입니다.
# 웹 링크 도메인은 카카오 개발자 콘솔 > 제품 링크 > 웹 도메인에 등록되어 있어야 합니다.
